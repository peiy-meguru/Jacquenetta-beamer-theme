\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeJacquenetta}%
  [2026/04/06 v1.0 Jacquenetta font theme]

\mode<presentation>

\RequirePackage[T1]{fontenc}
\RequirePackage{anyfontsize}
\RequirePackage{helvet}
\RequirePackage{setspace}

% === Chinese support ===========================================
\newif\ifjq@chinese
\jq@chinesefalse
\DeclareOptionBeamer{chinese}{\jq@chinesetrue}
\ProcessOptionsBeamer

\ifjq@chinese
  \RequirePackage{iftex}
  \ifXeTeX\else\ifLuaTeX\else
    \PackageError{beamerfontthemeJacquenetta}{%
      The `chinese' theme option requires XeLaTeX or LuaLaTeX.%
    }{Use xelatex or lualatex to compile this document.}
  \fi\fi
  \RequirePackage{ctex}
  \setCJKmainfont{Noto Sans CJK SC}[AutoFakeSlant, Scale=MatchLowercase]
  \setCJKsansfont{Noto Sans CJK SC}[AutoFakeSlant, Scale=MatchLowercase]
  \setCJKmonofont{Noto Sans CJK SC}[AutoFakeSlant, Scale=0.9]
  % Use TeX Gyre Heros (Helvetica clone) for Latin text under fontspec,
  % since ctex/fontspec override the helvet NFSS setup.
  \IfFontExistsTF{TeX Gyre Heros}{%
    \setsansfont{TeX Gyre Heros}%
  }{%
    \setsansfont{texgyreheros-regular.otf}[%
      BoldFont=texgyreheros-bold.otf,
      ItalicFont=texgyreheros-italic.otf,
      BoldItalicFont=texgyreheros-bolditalic.otf]%
  }
  % Predefine monospace font for listings and \texttt,
  % prefer DejaVu Sans Mono, fall back to Latin Modern Mono.
  \IfFontExistsTF{DejaVu Sans Mono}{%
    \newfontfamily\jq@monofont{DejaVu Sans Mono}[
      Scale=0.9,
      BoldFont=DejaVu Sans Mono Bold,
      SlantedFont=DejaVu Sans Mono Oblique
    ]%
  }{%
    \IfFontExistsTF{Latin Modern Mono}{%
      \newfontfamily\jq@monofont{Latin Modern Mono}[Scale=0.9]%
    }{%
      \newfontfamily\jq@monofont{lmmono10-regular.otf}[
        Scale=0.9,
        BoldFont=lmmonolt10-bold.otf,
        SlantedFont=lmmono10-italic.otf
      ]%
    }%
  }
\fi

% Sans-serif by default, serif for math only
\renewcommand{\familydefault}{\sfdefault}
\usefonttheme[onlymath]{serif}

% === Font assignments ==========================================
\setbeamerfont{title}{size=\fontsize{20}{24}\selectfont, series=\bfseries}
\setbeamerfont{subtitle}{size=\fontsize{12}{16}\selectfont}
\setbeamerfont{frametitle}{size=\fontsize{14}{18}\selectfont, series=\bfseries}
\setbeamerfont{author}{size=\fontsize{11}{14}\selectfont, series=\bfseries}
\setbeamerfont{institute}{size=\fontsize{9}{11}\selectfont}
\setbeamerfont{date}{size=\fontsize{9}{11}\selectfont}
\setbeamerfont{page number in head/foot}{%
  size=\fontsize{7}{9}\selectfont, series=\bfseries}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{10}{13}\selectfont}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{9}{12}\selectfont}
\setbeamerfont{footnote}{size=\fontsize{7}{9}\selectfont}

% Comfortable line spacing
\setstretch{1.25}

\mode<all>
\endinput
