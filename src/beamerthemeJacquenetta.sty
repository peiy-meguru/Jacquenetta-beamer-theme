% ----------------------------------------------------------
% beamerthemeJacquenetta.sty — Main theme loader
%
%
% 2026 Samuel Manchajm — CC BY-SA 4.0
%
% Usage:
%   \documentclass[aspectratio=169]{beamer}
%   \usetheme{Jacquenetta}
%
% Options:
%   accent=<color>   Change the accent color (default: jq@blue)
%                    e.g. accent=jq@orange, accent=teal
%   noborder         Disable the signature dark border
%   chinese          Enable CJK support for Chinese (XeLaTeX/LuaLaTeX)
%   code             Enable code environment support
%   flowchart        Enable flowchart environment support
%
% Dependencies: tikz, tcolorbox, listings (with `code` option), etoolbox (CJK
% fixes), helvet, microtype, setspace. With `flowchart`: tikz libraries
% shapes.geometric, positioning, arrows.meta. The `mwe` package is only needed
% for the example-image placeholder in example.tex.
% ----------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeJacquenetta}%
  [2026/04/06 v1.0 Jacquenetta Beamer theme]

\mode<presentation>

% === Pass options to sub-themes ================================
\newif\ifjq@chinese
\jq@chinesefalse
\newif\ifjq@code
\jq@codefalse
\newif\ifjq@flowchart
\jq@flowchartfalse
\DeclareOptionBeamer{accent}{%
  \PassOptionsToPackage{accent=#1}{beamercolorthemeJacquenetta}}
\DeclareOptionBeamer{noborder}{%
  \PassOptionsToPackage{noborder}{beamerouterthemeJacquenetta}}
\DeclareOptionBeamer{chinese}{%
  \PassOptionsToPackage{chinese}{beamerfontthemeJacquenetta}%
  \jq@chinesetrue}
\DeclareOptionBeamer{code}{\jq@codetrue}
\DeclareOptionBeamer{flowchart}{\jq@flowcharttrue}
\ProcessOptionsBeamer

% === Required packages =========================================
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{microtype}

% === Load sub-themes ===========================================
\usecolortheme{Jacquenetta}
\usefonttheme{Jacquenetta}
\useinnertheme{Jacquenetta}
\ifjq@chinese
  \useinnertheme{Jacquenetta-cjk}
\fi
\ifjq@code
  \useinnertheme{Jacquenetta-code}
\fi
\ifjq@flowchart
  \useinnertheme{Jacquenetta-flowchart}
\fi
\useoutertheme{Jacquenetta}

\mode<all>
\endinput
