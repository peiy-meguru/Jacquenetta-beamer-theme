\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemeJacquenetta-flowchart}%
  [2026/07/17 v1.2 Jacquenetta flowchart environments]

\mode<presentation>

\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, shapes.misc, positioning, arrows.meta}

% === Base node style =================================================
\tikzset{
  jqcbase/.style={
    font=\small\sffamily,
    text=jqdark,
    fill=white,
    draw=jqdark,
    line width=0.8pt,
    inner sep=6pt,
    minimum height=0.9cm,
    minimum width=2.2cm,
    align=center,
  },
  jqterminator/.style={
    jqcbase,
    shape=rounded rectangle,
    rounded rectangle west arc=0pt,
    rounded rectangle east arc=0pt,
    draw=jqaccent,
    line width=1.2pt,
  },
  jqprocess/.style={
    jqcbase,
    shape=rectangle,
  },
  jqdecision/.style={
    jqcbase,
    shape=diamond,
    aspect=2,
    inner sep=4pt,
  },
  jqio/.style={
    jqcbase,
    shape=trapezium,
    trapezium left angle=70,
    trapezium right angle=110,
  },
  jqsubprocess/.style={
    jqcbase,
    shape=rectangle,
    double=jqdark,
    double distance=1.5pt,
  },
}

% === Edge and label styles ===========================================
\tikzset{
  jqcedge/.style={
    ->,
    >={Stealth[length=3mm, width=2mm]},
    draw=jqdark,
    line width=1.2pt,
    rounded corners=3pt,
  },
  jqclabel/.style={
    font=\scriptsize\sffamily,
    text=jqgray,
    fill=white,
    inner sep=2pt,
  },
}

% === Direction helpers ===============================================
% The public \jqbranch command accepts direction keywords (left, right,
% above, below).  These lookup tables map those keywords to the
% corresponding TikZ compass anchors, to the anchor on the opposite
% side used for edge labels, to the target anchor that the orthogonal
% path should terminate on, and to the appropriate orthogonal path
% operator (-| for horizontal branches, |- for vertical ones).
\expandafter\def\csname jq@anchor@left\endcsname{west}
\expandafter\def\csname jq@anchor@right\endcsname{east}
\expandafter\def\csname jq@anchor@above\endcsname{north}
\expandafter\def\csname jq@anchor@below\endcsname{south}
\expandafter\def\csname jq@oppanchor@left\endcsname{east}
\expandafter\def\csname jq@oppanchor@right\endcsname{west}
\expandafter\def\csname jq@oppanchor@above\endcsname{south}
\expandafter\def\csname jq@oppanchor@below\endcsname{north}
\expandafter\def\csname jq@targetanchor@left\endcsname{east}
\expandafter\def\csname jq@targetanchor@right\endcsname{west}
\expandafter\def\csname jq@targetanchor@above\endcsname{south}
\expandafter\def\csname jq@targetanchor@below\endcsname{north}
\expandafter\def\csname jq@branch@left\endcsname{\jqbranch@h}
\expandafter\def\csname jq@branch@right\endcsname{\jqbranch@h}
\expandafter\def\csname jq@branch@above\endcsname{\jqbranch@v}
\expandafter\def\csname jq@branch@below\endcsname{\jqbranch@v}
\newcommand{\jqtoanchor}[1]{%
  \ifcsname jq@anchor@#1\endcsname
    \csname jq@anchor@#1\endcsname
  \else
    #1%
  \fi
}
\newcommand{\jqtooppanchor}[1]{%
  \ifcsname jq@oppanchor@#1\endcsname
    \csname jq@oppanchor@#1\endcsname
  \else
    #1%
  \fi
}
\newcommand{\jqtotargetanchor}[1]{%
  \ifcsname jq@targetanchor@#1\endcsname
    \csname jq@targetanchor@#1\endcsname
  \else
    #1%
  \fi
}

% === jqflowchart environment =========================================
\newenvironment{jqflowchart}[1][]{%
  \begin{tikzpicture}[#1]%
}{%
  \end{tikzpicture}%
}

% === \jqnode =========================================================
% Usage: \jqnode[<options>]{<type>}{<id>}{<text>}{<relative position>}
\newcommand{\jqnode}[5][]{%
  \node[jq#2, #1, #5] (#3) {#4};%
}

% === \jqedge =========================================================
% Usage: \jqedge[<options>]{<from>}{<to>}{<label>}
\newcommand{\jqedge}[4][]{%
  \if\relax\detokenize{#4}\relax
    \draw[jqcedge, #1] (#2) -- (#3);%
  \else
    \draw[jqcedge, #1] (#2) -- node[midway, jqclabel] {#4} (#3);%
  \fi
}

% === \jqbranch =======================================================
% Usage: \jqbranch[<options>]{<from>}{<to>}{<label>}{<direction>}
% <direction> should be a direction keyword such as left, right, above,
% or below.  It is mapped to the corresponding node anchor, to the
% opposite-side anchor used for the label, and to the target border
% anchor and orthogonal path operator appropriate for that direction.
% Drawing to the target's border anchor avoids PGF warnings on
% non-rectangular nodes (e.g. diamonds) and keeps arrowheads aligned.
\newcommand{\jqbranch@h}[5][]{%
  \draw[jqcedge, #1] (#2.\jqtoanchor{#5}) -- ++(\jqtoanchor{#5}:0.6cm) -| node[pos=0.25, jqclabel, anchor=\jqtooppanchor{#5}] {#4} (#3.\jqtotargetanchor{#5});%
}
\newcommand{\jqbranch@v}[5][]{%
  \draw[jqcedge, #1] (#2.\jqtoanchor{#5}) -- ++(\jqtoanchor{#5}:0.6cm) |- node[pos=0.25, jqclabel, anchor=\jqtooppanchor{#5}] {#4} (#3.\jqtotargetanchor{#5});%
}
\newcommand{\jqbranch}[5][]{%
  \ifcsname jq@branch@#5\endcsname
    \csname jq@branch@#5\endcsname[#1]{#2}{#3}{#4}{#5}%
  \else
    \jqbranch@h[#1]{#2}{#3}{#4}{#5}%
  \fi
}

\mode<all>
\endinput
